{
  "name": "PGxReports",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "clean": "cd android && gradlew clean && cd ..",
    "build:debug": "cd android && gradlew assembleDebug && cd ..",
    "build:release": "cd android && gradlew assembleRelease && cd ..",
    "build:clean": "npm run clean && npm run build:debug && npm run build:release",
    "optimize": "cd android && chmod +x clean-and-build.sh && ./clean-and-build.sh",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-community/cli": "^19.1.0",
    "@react-native/gradle-plugin": "0.77.3",
    "jsqr": "^1.4.0",
    "patch-package": "^8.0.0",
    "react": "18.3.1",
    "react-hook-form": "^7.60.0",
    "react-native": "0.77.3",
    "react-native-dotenv": "^3.4.11",
    "react-native-file-viewer": "^2.1.5",
    "react-native-fs": "^2.20.0",
    "react-native-hole-view": "^3.0.1",
    "react-native-loading-spinner-overlay": "^3.0.1",
    "react-native-paper": "5.10.0",
    "react-native-permissions": "^3.10.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-qrcode-generator": "^1.2.2",
    "react-native-qrcode-local-image": "^1.0.7",
    "react-native-reanimated": "3.16.1",
    "react-native-safe-area-context": "5.1.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.2.0",
    "react-native-vision-camera": "4.6.0",
    "rn-responsive-screen": "^1.1.9",
    "zxing-wasm": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "^0.77.3",
    "@react-native/eslint-config": "^0.77.3",
    "@react-native/metro-config": "^0.77.3",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.3.1",
    "typescript": "4.8.4"
  },
  "resolutions": {
    "@types/react": "^18"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
